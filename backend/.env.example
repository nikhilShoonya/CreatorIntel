# ---------------------------------------------------------------
# CreatorIntel backend configuration
# Copy to backend/.env and fill in real values. Never commit .env.
# ---------------------------------------------------------------

# YouTube Data API v3 key (Google Cloud Console -> APIs & Services -> Credentials).
# Several keys may be given comma-separated; the next is used when one is invalid or out of quota.
YOUTUBE_API_KEY=
# Daily quota per key (Google default 10000) - used for the "quota used today" view in Settings
YOUTUBE_DAILY_QUOTA=10000

# Meta / Instagram Graph API (Business Discovery)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_API_VERSION=v21.0
META_IG_BUSINESS_ACCOUNT_ID=
# Facebook Page whose videos/reels Video Performance tracks. META_ACCESS_TOKEN must be a
# System User token with this Page assigned (the Page token is derived at runtime).
META_FACEBOOK_PAGE_ID=

# Groq LLM used for genre / language / sentiment classification
# Create a key at https://console.groq.com/keys (several keys may also be listed here comma-separated)
GROQ_API_KEY=
# Or several separately authorised keys, used in order. The next key is used only when the active key is
# unusable (invalid/revoked key, restricted account) - never to get around rate or daily limits (Groq terms).
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# The only model used (must support strict JSON-schema output)
GROQ_MODEL=openai/gpt-oss-20b
# Optional extra models used after GROQ_MODEL's daily limit (must support strict JSON schema). Empty = 20b only.
GROQ_FALLBACK_MODELS=
# Free-plan per-minute limits; requests are paced below them instead of being retried after errors.
GROQ_REQUESTS_PER_MINUTE=30
GROQ_TOKENS_PER_MINUTE=8000
# Video Performance: videos rated per AI request.
AI_SENTIMENT_BATCH_SIZE=10
GROQ_BASE_URL=https://api.groq.com/openai/v1

# PostgreSQL connection string (e.g. Neon). Leave empty for local SQLite (backend/creatorintel.db).
# Neon example: postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Open database connections kept ready (a remote database needs ~1 s to open a new one)
DB_POOL_SIZE=10
# Keep a serverless database (Neon suspends after ~5 idle minutes) awake during these hours ("" = off)
DB_KEEP_WARM_HOURS=09:00-21:00

# Processing
AVERAGE_VIEWS_SAMPLE_SIZE=10
RECENT_CONTENT_FETCH_LIMIT=20
MAX_CONCURRENT_CREATORS=4
CACHE_TTL_HOURS=24
MAX_UPLOAD_SIZE_MB=10
# Uploaded files are deleted after this many days; their rows stay in the database and on the website
# (History > View file data, Tracking Library > Uploads). 0 = keep files forever.
UPLOAD_FILE_RETENTION_DAYS=30
HOUSEKEEPING_INTERVAL_HOURS=6
AI_MIN_CONFIDENCE=0.5

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
# Daily rotating log files (creatorintel.log, creatorintel.log.YYYY-MM-DD); secrets are redacted.
LOG_DIR=logs
LOG_RETENTION_DAYS=14

# --- Video Performance module (uses the same API keys as above) ---
VIDEO_TRACKING_SCHEDULER_ENABLED=true
VIDEO_TRACKING_TIMEZONE=Asia/Kolkata
# Daily jobs (HH:MM in the timezone above)
VIDEO_TRACKING_DISCOVERY_TIME=06:00
VIDEO_TRACKING_REFRESH_TIME=06:30
# Stop tracking a video after N days (0 = track forever)
VIDEO_TRACKING_MAX_DAYS=0
# "Video Down" videos are re-checked daily for N days after they were last seen, then only on Retry (0 = always)
VIDEO_TRACKING_DOWN_RECHECK_DAYS=14
# How many pages (50 posts each) of a creator's Instagram media to scan when looking for a reel
VIDEO_TRACKING_INSTAGRAM_SCAN_PAGES=4
