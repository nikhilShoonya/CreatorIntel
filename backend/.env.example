# ---------------------------------------------------------------
# CreatorIntel backend configuration
# Copy to backend/.env and fill in real values. Never commit .env.
# ---------------------------------------------------------------

# YouTube Data API v3 key (Google Cloud Console -> APIs & Services -> Credentials).
# Several keys may be given comma-separated; the next is used when one is invalid or out of quota.
YOUTUBE_API_KEY=
# Daily quota per key (Google default 10000) - used for the "quota used today" view in Settings
YOUTUBE_DAILY_QUOTA=10000
# Video Performance reads YouTube view counts this many times per check and keeps the highest
# (YouTube's servers sometimes return an older copy). Each extra read costs 1 unit per 50 videos.
YOUTUBE_VIEW_READS=3

# Meta / Instagram Graph API (Business Discovery)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_API_VERSION=v21.0
META_IG_BUSINESS_ACCOUNT_ID=
# Meta (Instagram) calls allowed per rolling hour, and Meta's reported hourly usage (%) at which the
# app stops calling. Work that does not fit waits as "Pending - waiting for Meta's hourly limit" and continues
# automatically, oldest first.
META_HOURLY_CALL_BUDGET=180
META_USAGE_STOP_PERCENT=80

# Optional public Reel metrics in Video Performance (does not affect Creator Analytics/posts).
# Get a backend-only token from https://console.apify.com/settings/integrations
# Effective only when enabled AND a token is present. No daily scraping is enabled by this flag.
APIFY_API_TOKEN=
APIFY_INSTAGRAM_REEL_ACTOR_ID=apify/instagram-reel-scraper
APIFY_INSTAGRAM_REEL_ENABLED=false
# Paid extra: opt in explicitly. Transcripts and video downloads are always off.
APIFY_INCLUDE_SHARES=false
APIFY_INSTAGRAM_REEL_BATCH_SIZE=25
# Conservative application result-unit guard, NOT an account billing/dollar cap. 0 prevents new runs.
APIFY_INSTAGRAM_REEL_MONTHLY_RESULT_LIMIT=1500
# Spending ceiling per Reel for one Actor run (billed per Reel actually returned; free plan price is $0.0026).
# The run's ceiling is never below Apify's minimum, so single-Reel Retry works.
APIFY_MAX_CHARGE_PER_REEL_USD=0.005

# Facebook metrics in Video Performance: public reels and videos of any Page, with the APIFY_API_TOKEN above.
# Effective only when enabled AND a token is present. No Meta token or Page ID is needed.
APIFY_FACEBOOK_ENABLED=false
APIFY_FACEBOOK_ACTOR_ID=chronometrica/facebook-metrics-scraper
# Links per Actor run. Each run is followed in the background and saved as soon as it finishes.
APIFY_FACEBOOK_BATCH_SIZE=10
# This app's own estimate and guard, separate from Instagram's, NOT an account billing cap. 0 prevents new runs.
APIFY_FACEBOOK_MONTHLY_RESULT_LIMIT=900
APIFY_FACEBOOK_MAX_CONCURRENCY=3
APIFY_FACEBOOK_INCLUDE_AUTHOR_PROFILE_METRICS=true
# true: a link without data gets its own row saying why, and that row is billed like any other.
# false: those links are only counted in the run summary, so the exact reason is often unknown.
APIFY_FACEBOOK_INCLUDE_FAILED_ROWS=true
APIFY_FACEBOOK_REQUEST_DELAY_MS=250
APIFY_FACEBOOK_MAX_FETCH_RETRIES=3
APIFY_FACEBOOK_REQUEST_TIMEOUT_SECS=20
# Reels use Meta first (owner known, Meta not paused); Apify takes over while Meta is paused or cannot read a
# reel, and Meta takes reels Apify cannot read. Switching back and forth is automatic.

# Groq LLM used for genre / language / sentiment classification
# Create a key at https://console.groq.com/keys (several keys may also be listed here comma-separated)
GROQ_API_KEY=
# Or several separately authorised keys, used in order. The next key is used only when the active key is
# unusable (invalid/revoked key, restricted account) - never to get around rate or daily limits (Groq terms).
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# The only model used (must support strict JSON-schema output)
GROQ_MODEL=openai/gpt-oss-20b
# Optional extra models used after GROQ_MODEL's daily limit (must support strict JSON schema). Empty = 20b only.
GROQ_FALLBACK_MODELS=
# Free-plan per-minute limits; requests are paced below them instead of being retried after errors.
GROQ_REQUESTS_PER_MINUTE=30
GROQ_TOKENS_PER_MINUTE=8000
# Video Performance: videos rated per AI request.
AI_SENTIMENT_BATCH_SIZE=10
GROQ_BASE_URL=https://api.groq.com/openai/v1

# PostgreSQL connection string (e.g. Neon). Leave empty for local SQLite (backend/creatorintel.db).
# Neon example: postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Open database connections kept ready (a remote database needs ~1 s to open a new one)
DB_POOL_SIZE=10
# Keep a serverless database (Neon suspends after ~5 idle minutes) awake during these hours ("" = off)
DB_KEEP_WARM_HOURS=09:00-21:00

# Processing
AVERAGE_VIEWS_SAMPLE_SIZE=10
RECENT_CONTENT_FETCH_LIMIT=20
MAX_CONCURRENT_CREATORS=4
CACHE_TTL_HOURS=24
MAX_UPLOAD_SIZE_MB=10
# 0 = keep uploaded files forever (default). N > 0 = delete the stored file after N days; its rows always stay
# in the database and on the website (History > View file data, Tracking Library > Uploads).
UPLOAD_FILE_RETENTION_DAYS=0
HOUSEKEEPING_INTERVAL_HOURS=6
AI_MIN_CONFIDENCE=0.5

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
# Daily rotating log files (creatorintel.log, creatorintel.log.YYYY-MM-DD); secrets are redacted.
LOG_DIR=logs
LOG_RETENTION_DAYS=14

# --- Video Performance module (uses the same API keys as above) ---
VIDEO_TRACKING_SCHEDULER_ENABLED=true
VIDEO_TRACKING_TIMEZONE=Asia/Kolkata
# Daily jobs (HH:MM in the timezone above)
VIDEO_TRACKING_DISCOVERY_TIME=06:00
# Automatic daily refresh of every tracked video's numbers: off by default (refresh per video, or "Run now"
# on the dashboard). true = run it every day at VIDEO_TRACKING_REFRESH_TIME.
VIDEO_TRACKING_AUTO_REFRESH=false
VIDEO_TRACKING_REFRESH_TIME=06:30
# Stop tracking a video after N days (0 = track forever)
VIDEO_TRACKING_MAX_DAYS=0
# "Video Down" videos are re-checked daily for N days after they were last seen, then only on Retry (0 = always)
VIDEO_TRACKING_DOWN_RECHECK_DAYS=14
# How many pages (50 posts each) of a creator's Instagram media to scan when looking for a reel
VIDEO_TRACKING_INSTAGRAM_SCAN_PAGES=4
