# =====================================================================
# CreatorIntel - root .gitignore (applies to backend/ and frontend/)
# =====================================================================

# ---- Secrets: never commit real credentials --------------------------
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.p12
*.pfx
secrets/
credentials*.json
service-account*.json

# ---- Python ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# ---- Local data (databases, uploaded files) ---------------------------
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
backend/uploads/*
!backend/uploads/.gitkeep

# ---- Node / Next.js ----------------------------------------------------
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Logs & OS / editor files ------------------------------------------
*.log
logs/
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# ---- Tooling -------------------------------------------------------------
.playwright-mcp/
.claude/
